#!/bin/sh

# Load in files
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$HOOK_DIR/lib.sh"



cd "$REPO_ROOT"

# Type

echo "Running Type Check ..."
mypy . 

mypy_status=$?

if [ $mypy_status -ne 0 ]; then
    echo "Push blocked: Type Errors to fix"
    enqueue_sound  "$(pick_random_failure_sound)"
    exit 1
fi

# Linter
echo "Running Ruff ..."
enqueue_sound  "$RUFF_SOUND"

ruff check .

ruff_status=$?

if [ $ruff_status -ne 0 ]; then
    echo "Push blocked: Ruff lint errors detected"
    enqueue_sound  "$(pick_random_failure_sound)"
    exit 1
fi

# Format

echo "Running Formatter (black)..."
enqueue_sound "$BLACK_SOUND"

black --check .

black_status=$?

if [ $black_status -ne 0 ]; then
    echo "Push blocked: Black failed to format the code"
    enqueue_sound  "$(pick_random_failure_sound)"
    exit 1
fi

# Double Check

if ! git diff --quiet; then
    echo "Push blocked: formatting issues detected"
    enqueue_sound  "$(pick_random_failure_sound)"
    exit 1
fi

# Tests

echo "Running Tests..."
pytest .


pytest_status=$?

if [ $pytest_status -ne 0 ]; then
    echo "Tests failed"
    enqueue_sound  "$(pick_random_failure_sound)"
    exit 1
fi


# Build

echo "Building..."
enqueue_sound  "$BUILD_SOUND"

pyinstaller main.py \
  --name MessedUpFarm \
  --onefile \
  --add-data "client/src/assets;client/src/assets" \
  --windowed

build_status=$?

if [ "$build_status" -ne 0 ]; then
    echo "Build failed"
    enqueue_sound  "$(pick_random_failure_sound)"
    exit 1
fi

enqueue_sound  "$(pick_random_success_sound)"
