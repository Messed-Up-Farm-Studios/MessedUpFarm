#!/bin/sh

# Load in files
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$HOOK_DIR/lib.sh"

cd "$SERVER_DIR" || exit 1

# Type

echo "Running Type Check ..."
uv run mypy $SRC

mypy_status=$?

if [ $mypy_status -ne 0 ]; then
    echo "Push blocked: Type Errors to fix"
    enqueue_sound  "$(pick_random_failure_sound)"
    exit 1
fi

# Linter
echo "Running Ruff ..."
enqueue_sound  "$RUFF_SOUND"

uv run ruff check $SRC

ruff_status=$?

if [ $ruff_status -ne 0 ]; then
    echo "Push blocked: Ruff lint errors detected"
    enqueue_sound  "$(pick_random_failure_sound)"
    exit 1
fi

# Format

echo "Running Formatter (black)..."
enqueue_sound "$BLACK_SOUND"

uv run black --check $SRC

black_status=$?

if [ $black_status -ne 0 ]; then
    echo "Push blocked: Black found unformatted code"
    enqueue_sound  "$(pick_random_failure_sound)"
    exit 1
fi

# Tests

echo "Running Tests..."
enqueue_sound  "$BUILD_SOUND"

uv run pytest

pytest_status=$?

# Exit code 5 means no tests were collected, which is not a failure
if [ $pytest_status -eq 5 ]; then
    echo "No tests collected, skipping"
elif [ $pytest_status -ne 0 ]; then
    echo "Push blocked: Tests failed"
    enqueue_sound  "$(pick_random_failure_sound)"
    exit 1
fi

enqueue_sound  "$(pick_random_success_sound)"
